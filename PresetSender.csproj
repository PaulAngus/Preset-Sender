<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.4</Version>
    <AssemblyTitle>Preset Sender</AssemblyTitle>
    <Product>Preset Sender</Product>
    <Title>Preset Sender</Title>
    <Description>General-purpose MIDI program change sender.</Description>
    <ApplicationIcon Condition="'$(SenderPlatform)' == 'Windows'">Assets/preset-sender.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MightBeUseful.Midi" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <ProjectReference Include="$(SharedMidiSourceRoot)/src/MightBeUseful.Midi/MightBeUseful.Midi.csproj" Condition="'$(SharedMidiSourceRoot)' != ''" />
    <AvaloniaResource Include="Assets/preset-sender-256.png" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="dependencies/**/*.cs" />
    <Compile Remove="Platforms/**/*.cs" />
    <Compile Include="Platforms/$(SenderPlatform)/MidiBackend.cs" />
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(SenderPlatform)' == 'Windows'">
    <PackageReference Include="Windows.Devices.Midi2" Version="0.99.88-preview.10" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <!-- Managed resources avoid extracting the native API at all on legacy Windows. -->
    <EmbeddedResource Include="$(PkgWindows_Devices_Midi2)/runtimes/win-x64/native/Windows.Devices.Midi2.dll" LogicalName="PresetSender.MidiApi.Windows.Devices.Midi2.dll" />
    <EmbeddedResource Include="$(PkgWindows_Devices_Midi2)/runtimes/win-x64/native/Windows.Devices.Midi2.pri" LogicalName="PresetSender.MidiApi.Windows.Devices.Midi2.pri" />
    <PackageReference Include="MightBeUseful.Midi.Windows" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <ProjectReference Include="$(SharedMidiSourceRoot)/src/MightBeUseful.Midi.Windows/MightBeUseful.Midi.Windows.csproj" Condition="'$(SharedMidiSourceRoot)' != ''" />
    <PackageReference Include="Avalonia.Win32" Version="11.2.3" />
  </ItemGroup>
  <PropertyGroup Condition="'$(SenderPlatform)' == 'Windows'">
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(SenderPlatform)' == 'macOS'">
    <PackageReference Include="MightBeUseful.Midi.CoreMidi" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <PackageReference Include="MightBeUseful.Midi.Rtp" Version="$(SharedMidiPackageVersion)" Condition="'$(SharedMidiSourceRoot)' == ''" />
    <ProjectReference Include="$(SharedMidiSourceRoot)/src/MightBeUseful.Midi.CoreMidi/MightBeUseful.Midi.CoreMidi.csproj" Condition="'$(SharedMidiSourceRoot)' != ''" />
    <PackageReference Include="Avalonia.Native" Version="11.2.3" />
  </ItemGroup>
</Project>
