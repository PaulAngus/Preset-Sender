<Project>
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;packages/**</DefaultItemExcludes>
  </PropertyGroup>
  <Import Project="build/DesktopPlatform.props" />
  <ItemGroup><Using Include="MightBeUseful.Midi" /></ItemGroup>
  <Import Project="dependencies/midi/MidiVersion.props" />
  <PropertyGroup Condition="('$(TestLabProfile)' == 'OfflineWindows' or '$(TestLabProfile)' == 'PhysicalWindowsReadOnly')"><DefineConstants>$(DefineConstants);TEST_LAB_OFFLINE_WINDOWS</DefineConstants></PropertyGroup>
</Project>
