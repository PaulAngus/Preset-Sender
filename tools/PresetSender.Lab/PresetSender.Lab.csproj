<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableMacOSCodeSign>false</EnableMacOSCodeSign>
  </PropertyGroup>
  <ItemGroup><Using Remove="MightBeUseful.Midi" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabAgentProject)' == '' and '$(TestLabProfile)' != 'OfflineWindows'"><PackageReference Include="ApplicationTestLab.Agent" Version="[0.2.5]" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabAgentProject)' == '' and '$(TestLabProfile)' == 'OfflineWindows'"><PackageReference Include="ApplicationTestLab.Agent" Version="[0.2.5]" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabAgentProject)' != ''"><ProjectReference Include="$(TestLabAgentProject)" /></ItemGroup>
  <ItemGroup Condition="('$(TestLabProfile)' == 'OfflineWindows' or '$(TestLabProfile)' == 'PhysicalWindowsReadOnly')"><Compile Remove="Program.cs" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabProfile)' != 'OfflineWindows'"><Compile Remove="OfflineProgram.cs" /></ItemGroup>
  <ItemGroup Condition="'$(TestLabProfile)' != 'PhysicalWindowsReadOnly'"><Compile Remove="PhysicalProgram.cs" /></ItemGroup>
</Project>
